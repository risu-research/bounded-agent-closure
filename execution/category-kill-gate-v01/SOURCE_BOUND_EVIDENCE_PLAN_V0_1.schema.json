{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risu-research.example/schemas/source-bound-evidence-plan-v0.1.json",
  "title": "Source-Bound Evidence Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "contract_id",
    "generic_vocabulary",
    "source_contracts",
    "acquisition_bindings",
    "proof_bindings",
    "maximum_justified_claim"
  ],
  "properties": {
    "schema_version": {"const": "SOURCE_BOUND_EVIDENCE_PLAN_V0_1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "generic_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acquisition_ops", "proof_ops", "completeness_procedures"],
      "properties": {
        "acquisition_ops": {
          "const": ["ENUMERATE", "OBSERVE", "WATCH", "SNAPSHOT"]
        },
        "proof_ops": {
          "const": ["CERTIFY_COMPLETE", "CERTIFY_TEMPORAL_CLOSURE"]
        },
        "completeness_procedures": {
          "const": ["SINGLE_COLLECTION", "STABLE_RESCAN", "EXHAUSTIVE_MEMBER_PROBE"]
        }
      }
    },
    "source_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_contract"}
    },
    "acquisition_bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/acquisition_binding"}
    },
    "proof_bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/proof_binding"}
    },
    "maximum_justified_claim": {"$ref": "#/$defs/claim_boundary"}
  },
  "$defs": {
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_class",
        "documentation_uri",
        "interface_kind",
        "integrity_mode",
        "trust_assumptions"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_class": {"type": "string", "minLength": 1},
        "documentation_uri": {"type": "string", "format": "uri"},
        "interface_kind": {
          "enum": ["HTTP_REST", "MCP_TOOL", "SDK_METHOD", "CLI_COMMAND", "EVENT_STREAM"]
        },
        "integrity_mode": {
          "enum": [
            "NONE",
            "AUTHENTICATED_TRANSPORT",
            "DIRECT_MEASUREMENT",
            "DIGEST_BOUND",
            "SIGNED_ATTESTATION",
            "HISTORICAL_RECORDED",
            "DERIVED"
          ]
        },
        "trust_assumptions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "interface_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_kind"],
      "properties": {
        "interface_kind": {
          "enum": ["HTTP_REST", "MCP_TOOL", "SDK_METHOD", "CLI_COMMAND", "EVENT_STREAM"]
        },
        "operation_id": {"type": "string", "minLength": 1},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"]},
        "path": {"type": "string", "minLength": 1},
        "tool_name": {"type": "string", "minLength": 1},
        "sdk_method": {"type": "string", "minLength": 1},
        "cli_command": {"type": "string", "minLength": 1},
        "event_stream": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"interface_kind": {"const": "HTTP_REST"}}},
          "then": {"required": ["method", "path"]}
        },
        {
          "if": {"properties": {"interface_kind": {"const": "MCP_TOOL"}}},
          "then": {"required": ["tool_name"]}
        },
        {
          "if": {"properties": {"interface_kind": {"const": "SDK_METHOD"}}},
          "then": {"required": ["sdk_method"]}
        },
        {
          "if": {"properties": {"interface_kind": {"const": "CLI_COMMAND"}}},
          "then": {"required": ["cli_command"]}
        },
        {
          "if": {"properties": {"interface_kind": {"const": "EVENT_STREAM"}}},
          "then": {"required": ["event_stream"]}
        }
      ]
    },
    "request_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "value_source", "value_ref"],
      "properties": {
        "parameter": {"type": "string", "minLength": 1},
        "value_source": {"enum": ["CONTRACT_INPUT", "PRIOR_STEP", "LITERAL", "RUNTIME_CONTEXT"]},
        "value_ref": {"type": ["string", "number", "integer", "boolean"]}
      }
    },
    "evidence_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_kind", "subject_from", "name", "selector", "value_type"],
      "properties": {
        "atom_kind": {
          "enum": [
            "RELATION_MEMBER",
            "FIELD_VALUE",
            "BINARY_RELATION",
            "EVENT",
            "SNAPSHOT",
            "TEMPORAL_ORIGIN",
            "ACQUISITION_FACT",
            "DERIVED_VALUE"
          ]
        },
        "subject_from": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "selector": {"type": "string", "minLength": 1},
        "value_type": {"enum": ["STRING", "NUMBER", "INTEGER", "BOOLEAN", "OBJECT", "ARRAY", "NULLABLE"]},
        "provenance_from": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "terminal_condition"],
      "properties": {
        "mode": {"enum": ["NONE", "CURSOR", "OFFSET", "TOKEN", "LINK"]},
        "request_cursor_parameter": {"type": "string", "minLength": 1},
        "response_next_selector": {"type": "string", "minLength": 1},
        "response_has_more_selector": {"type": "string", "minLength": 1},
        "terminal_condition": {"type": "string", "minLength": 1},
        "page_size_parameter": {"type": "string", "minLength": 1}
      }
    },
    "watch_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline_seconds", "initial_interval_seconds", "max_interval_seconds", "terminal_predicate", "timeout_claim"],
      "properties": {
        "deadline_seconds": {"type": "number", "exclusiveMinimum": 0},
        "initial_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
        "terminal_predicate": {"$ref": "#/$defs/expression"},
        "adverse_predicate": {"$ref": "#/$defs/expression"},
        "timeout_claim": {"enum": ["UNKNOWN", "REFUTED"]}
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "args"],
      "properties": {
        "op": {
          "enum": [
            "EXISTS",
            "NOT_EXISTS",
            "EQ",
            "NEQ",
            "IN",
            "GTE",
            "LTE",
            "AND",
            "OR",
            "NOT",
            "COUNT_GTE",
            "COUNT_LTE",
            "ALL",
            "ANY"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/expression"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["ref"],
                "properties": {"ref": {"type": "string", "minLength": 1}}
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["literal"],
                "properties": {"literal": {}}
              }
            ]
          }
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "claim", "scope", "unresolved_boundary"],
      "properties": {
        "status": {"enum": ["ESTABLISHABLE", "REFUTABLE", "BOUNDED_ONLY", "UNCOMPILABLE", "UNOBSERVABLE"]},
        "claim": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "unresolved_boundary": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "acquisition_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "judgment_id",
        "op",
        "logical_target",
        "source_id",
        "interface_operation",
        "request_bindings",
        "evidence_projection",
        "predicate",
        "depends_on",
        "claim_if_satisfied",
        "unknown_if"
      ],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "judgment_id": {"type": "string", "minLength": 1},
        "op": {"enum": ["ENUMERATE", "OBSERVE", "WATCH", "SNAPSHOT"]},
        "logical_target": {"type": "string", "minLength": 1},
        "scope_from": {"type": ["string", "null"]},
        "source_id": {"type": "string", "minLength": 1},
        "interface_operation": {"$ref": "#/$defs/interface_operation"},
        "request_bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/request_binding"}
        },
        "evidence_projection": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_projection"}
        },
        "predicate": {"$ref": "#/$defs/expression"},
        "pagination": {"$ref": "#/$defs/pagination"},
        "watch_policy": {"$ref": "#/$defs/watch_policy"},
        "depends_on": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "claim_if_satisfied": {"type": "string", "minLength": 1},
        "unknown_if": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "proof_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "judgment_id",
        "op",
        "logical_target",
        "depends_on",
        "claim_if_certified",
        "unknown_if"
      ],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "judgment_id": {"type": "string", "minLength": 1},
        "op": {"enum": ["CERTIFY_COMPLETE", "CERTIFY_TEMPORAL_CLOSURE"]},
        "logical_target": {"type": "string", "minLength": 1},
        "scope_from": {"type": ["string", "null"]},
        "depends_on": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "completeness_procedure": {
          "enum": ["SINGLE_COLLECTION", "STABLE_RESCAN", "EXHAUSTIVE_MEMBER_PROBE"]
        },
        "temporal_horizon_seconds": {"type": "number", "exclusiveMinimum": 0},
        "claim_if_certified": {"type": "string", "minLength": 1},
        "unknown_if": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}